{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product-feedback-aggregator:config-schema:v1",
  "title": "Product Feedback Aggregator configuration",
  "description": "Structural configuration contract. Cross-field, filesystem, policy-freshness, credential, and cost semantics are enforced by feedback check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "sources"],
  "properties": {
    "version": {"const": 1},
    "product": {"$ref": "#/$defs/product"},
    "storage": {"$ref": "#/$defs/storage"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "limits": {"$ref": "#/$defs/limits"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "outputs": {"$ref": "#/$defs/outputs"},
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "aliases": {"$ref": "#/$defs/stringList"},
        "terms": {"$ref": "#/$defs/stringList"},
        "exclusions": {"$ref": "#/$defs/stringList"},
        "languages": {"$ref": "#/$defs/stringList"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"author_salt_file": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items_per_source": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 1000000000},
        "max_line_bytes": {"type": "integer", "minimum": 256, "maximum": 100000000},
        "max_url_bytes": {"type": "integer", "minimum": 1024, "maximum": 100000000},
        "max_decompressed_bytes": {"type": "integer", "minimum": 1024, "maximum": 200000000},
        "connect_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 60},
        "read_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 300},
        "total_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 600},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 10},
        "external_timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 3600},
        "external_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1000000000}
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"maxProperties": 0},
        {"required": ["authors", "sources", "recency", "severity", "relevance", "engagement"]}
      ],
      "properties": {
        "authors": {"type": "number", "minimum": 0, "maximum": 1},
        "sources": {"type": "number", "minimum": 0, "maximum": 1},
        "recency": {"type": "number", "minimum": 0, "maximum": 1},
        "severity": {"type": "number", "minimum": 0, "maximum": 1},
        "relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "engagement": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relevance_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "suppression_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "cluster_similarity_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "weights": {"$ref": "#/$defs/weights"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"directory": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "command", "model"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "type": {"const": "local_subprocess"},
        "enabled": {"type": "boolean"},
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_schema_version": {"const": 1},
        "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 600},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition_mode": {"type": "string"},
        "approval_required": {"type": "boolean"},
        "approval_reference": {"type": "string"},
        "credential_owner": {"type": "string"},
        "commercial_use_allowed": {"type": ["boolean", "null"]},
        "remote_processing_allowed": {"type": "boolean"},
        "raw_ttl_hours": {"type": "integer", "minimum": 0},
        "deletion_reconcile_interval_hours": {"type": "integer", "minimum": 1},
        "redistribution_mode": {"type": "string"},
        "cost_per_resource_usd": {"type": "number", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "policy_version": {"type": "string"},
        "policy_version_checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "sourceBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "type": {
          "enum": [
            "json", "url", "external", "reddit", "x", "reddit_apify", "x_apify"
          ]
        },
        "enabled": {"type": "boolean"},
        "max_items": {"type": "integer", "minimum": 1},
        "options": {"type": "object"},
        "policy": {"$ref": "#/$defs/policy"}
      }
    },
    "source": {
      "allOf": [
        {"$ref": "#/$defs/sourceBase"},
        {
          "if": {"properties": {"type": {"const": "json"}}, "required": ["type"]},
          "then": {
            "properties": {
              "options": {
                "type": "object", "additionalProperties": false,
                "required": ["paths"],
                "properties": {
                  "paths": {
                    "type": "array", "minItems": 1,
                    "items": {"$ref": "#/$defs/nonEmptyString"}
                  },
                  "permissive": {"type": "boolean"},
                  "mapping": {"$ref": "#/$defs/mapping"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "url"}}, "required": ["type"]},
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "object", "additionalProperties": false,
                "required": ["urls"],
                "properties": {
                  "urls": {
                    "type": "array", "minItems": 1,
                    "items": {"$ref": "#/$defs/nonEmptyString"}
                  },
                  "allow_http": {"type": "boolean"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "external"}}, "required": ["type"]},
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "type": "object", "additionalProperties": false,
                "oneOf": [
                  {"required": ["path"]},
                  {"required": ["stdin"]},
                  {"required": ["command"]}
                ],
                "properties": {
                  "path": {"$ref": "#/$defs/nonEmptyString"},
                  "stdin": {"const": true},
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {"type": "string", "minLength": 1, "maxLength": 4096}
                  },
                  "mapping": {"$ref": "#/$defs/mapping"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "reddit"}}, "required": ["type"]},
          "then": {
            "required": ["options", "policy"],
            "properties": {
              "options": {
                "type": "object", "additionalProperties": false,
                "required": ["approval_confirmed", "user_agent", "subreddits"],
                "properties": {
                  "approval_confirmed": {"const": true},
                  "client_id_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
                  "client_secret_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
                  "user_agent": {"type": "string", "minLength": 1, "maxLength": 512},
                  "subreddits": {
                    "type": "array", "minItems": 1, "maxItems": 50,
                    "items": {"type": "string", "pattern": "^(all|[A-Za-z0-9_]{2,21})$"}
                  },
                  "query": {"type": "string", "minLength": 1, "maxLength": 512},
                  "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
                  "max_pages": {"type": "integer", "minimum": 1, "maximum": 1000},
                  "max_comments_per_post": {"type": "integer", "minimum": 0, "maximum": 500},
                  "comment_depth": {"type": "integer", "minimum": 1, "maximum": 10},
                  "sort": {"const": "new"},
                  "time_filter": {"enum": ["hour", "day", "week", "month", "year", "all"]}
                }
              },
              "policy": {
                "allOf": [
                  {"$ref": "#/$defs/policy"},
                  {
                    "required": ["policy_version", "policy_version_checked_at"],
                    "properties": {
                      "acquisition_mode": {"const": "official_api"},
                      "raw_ttl_hours": {"type": "integer", "minimum": 1},
                      "policy_version": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "x"}}, "required": ["type"]},
          "then": {
            "required": ["options", "policy"],
            "properties": {
              "max_items": {"type": "integer", "minimum": 5, "maximum": 100000},
              "options": {
                "type": "object", "additionalProperties": false,
                "required": ["approval_confirmed"],
                "properties": {
                  "approval_confirmed": {"const": true},
                  "bearer_token_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
                  "mode": {"enum": ["recent", "recent_search", "mentions"]},
                  "query": {"type": "string", "minLength": 1, "maxLength": 512},
                  "user_id": {"type": "string", "pattern": "^[0-9]{1,19}$"},
                  "page_size": {"type": "integer", "minimum": 5, "maximum": 100},
                  "max_pages": {"type": "integer", "minimum": 1, "maximum": 1000},
                  "sort_order": {"enum": ["recency", "relevancy"]}
                },
                "allOf": [
                  {
                    "if": {"properties": {"mode": {"const": "mentions"}}, "required": ["mode"]},
                    "then": {"required": ["user_id"]},
                    "else": {"properties": {"page_size": {"minimum": 10}}}
                  }
                ]
              },
              "policy": {
                "allOf": [
                  {"$ref": "#/$defs/policy"},
                  {
                    "required": [
                      "cost_per_resource_usd",
                      "max_cost_usd",
                      "policy_version",
                      "policy_version_checked_at"
                    ],
                    "properties": {
                      "acquisition_mode": {"const": "official_api"},
                      "raw_ttl_hours": {"type": "integer", "minimum": 1},
                      "cost_per_resource_usd": {"type": "number", "exclusiveMinimum": 0},
                      "max_cost_usd": {"type": "number", "exclusiveMinimum": 0},
                      "policy_version": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "options": {
                      "properties": {"mode": {"const": "mentions"}},
                      "required": ["mode"]
                    }
                  },
                  "required": ["options"]
                },
                "then": {"properties": {"max_items": {"minimum": 5}}},
                "else": {"properties": {"max_items": {"minimum": 10}}}
              }
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "reddit_apify"}},
            "required": ["type"]
          },
          "then": {
            "required": ["options", "policy"],
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["approval_confirmed", "actor_build"],
                "not": {"required": ["searches", "start_urls"]},
                "properties": {
                  "approval_confirmed": {"const": true},
                  "token_env": {
                    "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
                  },
                  "actor_build": {
                    "type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,5}$"
                  },
                  "searches": {
                    "type": "array", "minItems": 1, "maxItems": 20,
                    "items": {"type": "string", "minLength": 1, "maxLength": 512}
                  },
                  "start_urls": {
                    "type": "array", "minItems": 1, "maxItems": 50,
                    "items": {"type": "string", "minLength": 1, "maxLength": 4096}
                  },
                  "search_community_name": {
                    "type": "string", "pattern": "^[A-Za-z0-9_]{2,21}$"
                  },
                  "search_comments": {"type": "boolean"},
                  "max_post_count": {"type": "integer", "minimum": 1, "maximum": 10000},
                  "max_comments": {"type": "integer", "minimum": 0, "maximum": 500},
                  "include_nsfw": {"type": "boolean"},
                  "dataset_page_size": {"type": "integer", "minimum": 1, "maximum": 500},
                  "poll_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 30},
                  "initial_lookback_days": {"type": "integer", "minimum": 1, "maximum": 365},
                  "overlap_hours": {"type": "integer", "minimum": 1, "maximum": 168}
                }
              },
              "policy": {
                "allOf": [
                  {"$ref": "#/$defs/policy"},
                  {
                    "required": [
                      "remote_processing_allowed",
                      "max_cost_usd",
                      "policy_version",
                      "policy_version_checked_at"
                    ],
                    "properties": {
                      "acquisition_mode": {"const": "third_party_scraper"},
                      "remote_processing_allowed": {"const": true},
                      "raw_ttl_hours": {"type": "integer", "minimum": 1},
                      "max_cost_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
                      "policy_version": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"type": {"const": "x_apify"}},
            "required": ["type"]
          },
          "then": {
            "required": ["options", "policy"],
            "properties": {
              "options": {
                "type": "object",
                "additionalProperties": false,
                "required": ["approval_confirmed", "actor_build"],
                "not": {"required": ["search_terms", "start_urls"]},
                "properties": {
                  "approval_confirmed": {"const": true},
                  "token_env": {
                    "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
                  },
                  "actor_build": {
                    "type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,5}$"
                  },
                  "search_terms": {
                    "type": "array", "minItems": 1, "maxItems": 50,
                    "items": {"type": "string", "minLength": 1, "maxLength": 512}
                  },
                  "start_urls": {
                    "type": "array", "minItems": 1, "maxItems": 50,
                    "items": {"type": "string", "minLength": 1, "maxLength": 4096}
                  },
                  "sort": {"enum": ["Top", "Latest", "Latest + Top"]},
                  "tweet_language": {"type": "string", "pattern": "^[a-z]{2}$"},
                  "exclude_retweets": {"type": "boolean"},
                  "dataset_page_size": {"type": "integer", "minimum": 1, "maximum": 500},
                  "poll_interval_seconds": {"type": "number", "minimum": 0.1, "maximum": 30},
                  "initial_lookback_days": {"type": "integer", "minimum": 1, "maximum": 365},
                  "overlap_hours": {"type": "integer", "minimum": 1, "maximum": 168}
                }
              },
              "policy": {
                "allOf": [
                  {"$ref": "#/$defs/policy"},
                  {
                    "required": [
                      "remote_processing_allowed",
                      "max_cost_usd",
                      "policy_version",
                      "policy_version_checked_at"
                    ],
                    "properties": {
                      "acquisition_mode": {"const": "third_party_scraper"},
                      "remote_processing_allowed": {"const": true},
                      "raw_ttl_hours": {"type": "integer", "minimum": 1},
                      "max_cost_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
                      "policy_version": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
